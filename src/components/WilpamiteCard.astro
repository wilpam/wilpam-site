---
const { name, cardClass, pronouns } = Astro.props
const cardClasses = `card ${cardClass}`
---

<div class={cardClasses}>
  <div id="top">
    <span id="first">?</span>
    <span id="name">{name}</span>
    <span id="pronouns">{pronouns}</span>
  </div>
  <div id="description"><slot/></div>
</div>

<style>

  .card {
    padding: 5px;
    border: 1px solid white;
    border-radius: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  #top {
    width: 100%;
    display: flex;
  }

  #first {
    color: #ffffff7f;
    flex: 1;
  }

  #name {
    text-align: center;
    font-size: 16pt;
    flex: 1;
  }

  #pronouns {
    text-align: right;
    color: #ffffff7f;
    flex: 1;
  }

  #description {
    width: 100%;
    text-align: center;
  }

</style>