---
const { name, cardClass, pronouns, site, description } = Astro.props
const cardClasses = `card ${cardClass}`
const authorId = `author-${name.toLowerCase()}`
import { Image } from "astro:assets";
import LinkImage from "../assets/icons/link.svg"
import MemberLink from "./MemberLink.astro";
---

<div id={authorId} class={cardClasses}>
  <div id="top">
    <span id="first"><MemberLink name={name}><Image id="link-image" src={LinkImage} alt="Link" height="16" /></MemberLink></span>
    <span id="name">{name}</span>
    <span id="pronouns">{pronouns}</span>
  </div>
  <div id="description" set:html={description}></div>
</div>

<style>

  .card {
    display: flex;
    flex-direction: column;
    padding: 5px;
    border: 1px solid white;
    border-radius: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  #top {
    width: 100%;
    display: flex;
  }

  #first {
    color: #ffffff7f;
    flex: 1;
  }

  #link-image {
    filter: invert() opacity(50%);
  }

  #name {
    text-align: center;
    font-size: 16pt;
    flex: 1;
  }

  #pronouns {
    text-align: right;
    color: #ffffff7f;
    flex: 1;
  }

  #description {
    width: 100%;
    text-align: center;
  }
</style>
