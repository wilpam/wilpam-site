---
import Layout from "../layouts/Layout.astro"
import NarrowPage from "../components/NarrowPage.astro";
import WilpamEffect from "../components/WilpamEffect.astro";
import WilpamiteCard from "../components/WilpamiteCard.astro";
import QnA from "../components/QnA.astro";
---

<Layout>
	<NarrowPage>
		<h1>Welcome to the website of <WilpamEffect text="wilpam erkithe eolesl" />!</h1>
		<p>We are a group of 10 people who occasionally do indescribable things.</p>

		<div class="cards-row">
			<WilpamiteCard name="Liv" pronouns="he/him" cardClass="liv-card">
				Liv is Liv
			</WilpamiteCard>
			<WilpamiteCard name="Digi" pronouns="he/him" cardClass="digi-card">
				Digi is a programmer and designer of all things he can get his hands on.
			</WilpamiteCard>
			<WilpamiteCard name="Emerald" pronouns="he/him" cardClass="emerald-card">
				Emerald is Emerald
			</WilpamiteCard>
			<WilpamiteCard name="Yoosure" pronouns="he/him" cardClass="yoosure-card">
				Yoosure is Yoosure
			</WilpamiteCard>
			<WilpamiteCard name="Legi" pronouns="he/him" cardClass="legi-card">
				Legi is Legi
			</WilpamiteCard>
		</div>

		<div class="cards-row">
			<WilpamiteCard name="Andrew" pronouns="he/him" cardClass="andrew-card">
				Andrew is Andrew
			</WilpamiteCard>
			<WilpamiteCard name="Whirl" pronouns="he/him" cardClass="whirl-card">
				Whirl is a programmer
			</WilpamiteCard>
			<WilpamiteCard name="Quin" pronouns="he/him" cardClass="quin-card">
				Quin is Quin
			</WilpamiteCard>
			<WilpamiteCard name="Mac" pronouns="he/him" cardClass="mac-card">
				Mac is Mac
			</WilpamiteCard>
			<WilpamiteCard name="Lucy" pronouns="he/him" cardClass="lucy-card">
				Lucy is Lucy
			</WilpamiteCard>
		</div>
	

		<QnA question="Why are you called that?">
			j
		</QnA>

	</NarrowPage>
</Layout>

<style>
	.cards-row {
		max-width: 100%;
		display: flex;
		padding: 1rem 2rem;
		gap: 2rem;
	}
</style>