---
import WilpamEffect from "../components/WilpamEffect.astro";
import WilpamiteCard from "../components/WilpamiteCard.astro";
import QnA from "../components/QnA.astro";
import NarrowLayout from "../layouts/NarrowLayout.astro";
import { people } from "../data/people";
---

<NarrowLayout>
	<h1>Welcome to the website of <WilpamEffect text="wilpam erkithe eolesl" />!</h1>
	<p>We are a group of 10 people who occasionally do indescribable things.</p>

	<div class="cards-row">
		{people.slice(0, 5).map((person) => <WilpamiteCard {...person} />)}
	</div>

	<div class="cards-row">
		{people.slice(5).map((person) => <WilpamiteCard {...person} />)}
	</div>

	<h2>Q&A</h2>

	<div class="qnas">

		<QnA question="Why are you called that?">
			j
		</QnA>

		<QnA question="What things do you do, exactly?">
			Indescribable.<br>
			But if you have to know, mostly programming projects, worldbuilding, and everything you can imagine goes with those.
		</QnA>

	</div>

</NarrowLayout>

<style>
	.cards-row {
		max-width: 100%;
		display: flex;
		padding: 1rem 2rem;
		gap: 2rem;
	}

	.qnas {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 1rem;
	}
</style>
