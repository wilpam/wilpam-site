---
import BlogPost from "../components/BlogPost.astro";
import NarrowLayout from "../layouts/NarrowLayout.astro";
const posts = Object.values(import.meta.glob('./blog/*.mdx', { eager: true }));
---

<NarrowLayout>
	<h1 id="welcome">Welcome to our blog</h1>
	<ul id="entries">
		{posts.map((post: any) => <li><BlogPost name={post.frontmatter.title} link={post.url} author={post.frontmatter.author} date={post.frontmatter.date.slice(0,10)} /></li>)}
	</ul>
</NarrowLayout>

<style>
	#entries {
		list-style-type: none;
		padding-left: 0;
	}
</style>

<script>
	const vowels = ["a","e","i","u","a","e","i","u","æ","ə"];
	let idx = Math.floor(Math.random()*vowels.length);
	const welcome = document.getElementById("welcome")
	if (welcome) {
		welcome.innerHTML = `Welcome to our bl${vowels[idx]}g!`
	}
</script>