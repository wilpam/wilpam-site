---
import BlogPost from "../components/BlogPost.astro";
import NarrowLayout from "../layouts/NarrowLayout.astro";
import { formatDate, posts, postTags } from "../data/blog";
---

<NarrowLayout>
	<h1 id="welcome">Welcome to our blog</h1>
	<ul id="entries">
		{posts.map((post) => <li><BlogPost name={post.frontmatter.title} link={post.url} author={post.frontmatter.author} date={formatDate(post.frontmatter.date)} tags={postTags(post)} /></li>)}
	</ul>
</NarrowLayout>

<style>
	#entries {
		list-style-type: none;
		padding-left: 0;
	}
</style>

<script>
	const vowels = ["a","e","i","u","a","e","i","u","æ","ə"];
	let idx = Math.floor(Math.random()*vowels.length);
	const welcome = document.getElementById("welcome")
	if (welcome) {
		welcome.innerHTML = `Welcome to our bl${vowels[idx]}g!`
	}
</script>
